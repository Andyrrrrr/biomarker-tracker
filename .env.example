# Copy to .env.local (gitignored) and fill in. On Vercel, set the same names in
# Project → Settings → Environment Variables.

# Supabase → Connect. Locally: Session pooler (port 5432). On Vercel: Transaction pooler (6543).
# Includes your database password: secret.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The project's URL and its publishable key (Supabase → Project Settings → API Keys), used for
# sign-in only. Not secret: they ship to the browser, the Data API is off (README) and every table
# has row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The only email allowed to sign in and see your data.
OWNER_EMAIL=you@example.com

# Optional, local only: skip sign-in under `npm run dev` (you're treated as the owner). Ignored by
# production builds. Leave unset on Vercel.
# DEV_SKIP_SIGN_IN=true
